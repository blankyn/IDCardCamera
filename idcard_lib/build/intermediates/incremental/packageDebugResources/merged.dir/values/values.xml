    <string name="capture_button_alt">Capture</string>
    <string name="crop_fail">裁剪失败</string>
    <string name="idcard_finish">完成</string>
    <string name="idcard_net_step_str">下一步</string>
    <string name="idcard_positive_reverse_tip_str">请尽量将身份证填满框内</string>
    <string name="permission_open_str">请手动打开该应用需要的权限</string>
